[Unit]
Description=llama-server (davidau) - Qwen3.6-27B Fable-Fusion-711 NEO-AMD-MTP-Q6_K
Documentation=https://huggingface.co/DavidAU/Qwen3.6-27B-Fable-Fusion-711-Uncensored-Heretic-NM-DAU-NEO-MAX-MTP-GGUF
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Container]
ContainerName=llama-davidau
# Standard GGUF — no fork required, uses upstream llama.cpp image.
Image=localhost/llama-rocm-7.2.4:latest

AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
Network=host

Volume=/srv/llm/models:/models:ro,z
Volume=/srv/llm/templates:/templates:ro,z

Environment=HIP_VISIBLE_DEVICES=0

PodmanArgs=--security-opt seccomp=unconfined
PodmanArgs=--ipc=host

Notify=healthy
HealthCmd=curl -sf http://127.0.0.1:8085/health || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=90
HealthStartPeriod=30s

# AMD variants (NEO-AMD-*) have output tensor in f16 instead of bf16.
# This is required on AMD — bf16 output forces CPU offload and kills throughput.
#
# File options (all have MTP heads, all AMD-tuned):
#   NEO-AMD-MTP-Q6_K.gguf   24 GB  — best quality (used here)
#   NEO-AMD-MTP-IQ4_XS.gguf 16.8 GB — smallest footprint
#
# Vision: add --mmproj /models/mmproj-F16.gguf to enable image input.
#
# MTP constraint: rep_pen MUST stay at 1.0. Raising it collapses acceptance
# rates below 50%, at which point the MTP overhead costs more than it saves.
# Switch to the non-MTP Q6_K if acceptance stays low on your workload.
#
# Thinking mode samplers: temp=1.0 top_p=0.95 (override via API per-request).
# Single quotes around JSON are load-bearing: systemd strips bare double quotes.
Exec=llama-server \
      --alias davidau \
      -m /models/Qwen3.6-27B-Fable-Fus-711-UnHeretic-NM-DAU-NEO-MAX-NEO-AMD-MTP-Q6_K.gguf \
      --host 0.0.0.0 --port 8085 \
      -c 65536 -np 1 \
      --no-context-shift \
      -ngl 99 -fa on \
      -ctk q8_0 -ctv q8_0 \
      -b 2048 -ub 512 \
      --spec-type draft-mtp \
      --spec-draft-n-max 2 \
      --jinja \
      --chat-template-file /templates/qwen-froggeric-v21.jinja \
      --chat-template-kwargs '{"enable_thinking":false}' \
      --temp 0.7 --top-p 0.80 --top-k 20 --min-p 0.0 --presence-penalty 1.5

[Service]
Restart=on-failure
RestartSec=20
TimeoutStartSec=1200
TimeoutStopSec=90

[Install]
WantedBy=default.target
