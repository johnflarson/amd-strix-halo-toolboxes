[Unit]
Description=llama-server (tools) - Qwen3.5-9B Q8_0, 6 slots for tool dispatch
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target llama-server-code.service
Wants=network-online.target llama-server-code.service
StartLimitIntervalSec=1800
StartLimitBurst=3

[Container]
ContainerName=llama-tools
Image=localhost/llama-rocm-7.2.4:latest

AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
Network=host

Volume=/srv/llm/models:/models:ro,z
Volume=/srv/llm/templates:/templates:ro,z

Environment=HIP_VISIBLE_DEVICES=0

PodmanArgs=--security-opt seccomp=unconfined
PodmanArgs=--ipc=host

Notify=healthy
HealthCmd=curl -sf http://127.0.0.1:8083/health || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=60
HealthStartPeriod=30s

# 9B vanilla Qwen3.5 — no MTP heads, no --spec-type flags.
# 6 slots: 9B at Q8_0 costs ~21 GB total (weights + KV), so concurrency is cheap.
# 32K context: tool calls are short; this is a ceiling, not a target.
# --presence-penalty discourages the model from repeating tool calls already made.
# Single quotes around JSON are load-bearing: systemd strips bare double quotes.
Exec=llama-server \
      --alias tools \
      -m /models/Qwen3.5-9B-Q8_0.gguf \
      --host 0.0.0.0 --port 8083 \
      -c 32768 -np 6 \
      --no-context-shift \
      -ngl 99 -fa on \
      -ctk q8_0 -ctv q8_0 \
      -b 2048 -ub 512 \
      --jinja \
      --chat-template-file /templates/qwen-froggeric-v21.jinja \
      --chat-template-kwargs '{"enable_thinking":false}' \
      --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0.0 --presence-penalty 1.5

[Service]
Restart=on-failure
RestartSec=20
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=default.target
