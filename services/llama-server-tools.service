[Unit]
Description=llama-server (tools) - Qwen3.5-9B Q8_0, 4 slots for tool dispatch
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target llama-server-code.service
Wants=network-online.target llama-server-code.service
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=exec
Restart=on-failure
RestartSec=20
TimeoutStartSec=600
TimeoutStopSec=90

ExecStart=/usr/bin/podman run --rm --replace --name llama-tools \
    --device /dev/kfd --device /dev/dri \
    --group-add keep-groups \
    --security-opt seccomp=unconfined \
    --ipc=host --network=host \
    -v /srv/llm/models:/models:ro,z \
    -v /srv/llm/templates:/templates:ro,z \
    -e HIP_VISIBLE_DEVICES=0 \
    docker.io/kyuz0/amd-strix-halo-toolboxes:rocm-7.2.4 \
    llama-server \
      --alias tools \
      -m /models/Qwen3.5-9B-Q8_0.gguf \
      --host 0.0.0.0 --port 8083 \
      -c 65536 -np 4 \
      --no-context-shift \
      -ngl 99 -fa on \
      -ctk q8_0 -ctv q8_0 \
      -b 2048 -ub 512 \
      --cache-ram 2048 \
      --jinja \
      --chat-template-file /templates/qwen-froggeric-v21.jinja \
      --chat-template-kwargs {"enable_thinking":false} \
      --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0.0 --presence-penalty 1.5

ExecStartPost=/usr/bin/timeout 570 sh -c 'until curl -sf http://127.0.0.1:8083/health >/dev/null 2>&1; do sleep 3; done'

ExecStop=/usr/bin/podman stop -t 60 llama-tools

[Install]
WantedBy=default.target
