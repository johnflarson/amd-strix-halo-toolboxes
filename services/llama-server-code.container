[Unit]
Description=llama-server (code) - Qwen3.6-27B MTP UD-Q4_K_XL, single slot
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target llama-server-chat.service
Wants=network-online.target llama-server-chat.service
StartLimitIntervalSec=1800
StartLimitBurst=3

[Container]
ContainerName=llama-code
Image=localhost/llama-rocm-7.2.4-rocmfpx:latest

AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
Network=host

Volume=/srv/llm/models:/models:ro,z
Volume=/srv/llm/templates:/templates:ro,z

Environment=HIP_VISIBLE_DEVICES=0

PodmanArgs=--security-opt seccomp=unconfined
PodmanArgs=--ipc=host

Notify=healthy
HealthCmd=curl -sf http://127.0.0.1:8082/health || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=90
HealthStartPeriod=30s

# MTP requires a llama.cpp build carrying PR #22673. Verify with:
#   podman run --rm localhost/llama-rocm-7.2.4-rocmfpx:latest \
#     llama-server --help | grep -i spec-type
# If absent, drop the two --spec-* args and move to UD-Q5_K_XL instead.
Exec=llama-server \
      --alias code \
      -m /models/Qwen3.6-27B-MTP-UD-Q4_K_XL.gguf \
      --host 0.0.0.0 --port 8082 \
      -c 163840 -np 1 \
      --no-context-shift \
      -ngl 99 -fa on \
      -ctk q8_0 -ctv q8_0 \
      -b 4096 -ub 2048 \
      --cache-ram 12288 \
      --spec-type draft-mtp --spec-draft-n-max 2 \
      --jinja \
      --chat-template-file /templates/qwen-froggeric-v21.jinja \
      --chat-template-kwargs '{"enable_thinking":false}' \
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0

[Service]
Restart=on-failure
RestartSec=20
TimeoutStartSec=1200
TimeoutStopSec=90

[Install]
WantedBy=default.target
