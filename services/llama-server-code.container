[Unit]
Description=llama-server (code) - Qwopus3.6-27B-Coder ROCmFP4, single slot
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target llama-server-chat.service
Wants=network-online.target llama-server-chat.service
StartLimitIntervalSec=1800
StartLimitBurst=3

[Container]
ContainerName=llama-code
Image=localhost/llama-rocm-7.2.4-rocmfpx:latest

AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
Network=host

Volume=/srv/llm/models:/models:ro,z
Volume=/srv/llm/templates:/templates:ro,z

# Vulkan0 backend — same image as chat (charlie12345/ROCmFPX)
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=GGML_HIP_ENABLE_UNIFIED_MEMORY=1

PodmanArgs=--security-opt seccomp=unconfined
PodmanArgs=--ipc=host

Notify=healthy
HealthCmd=curl -sf http://127.0.0.1:8082/health || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=90
HealthStartPeriod=30s

# MTP requires a build carrying the MTP spec tensors. Verify with:
#   podman run --rm localhost/llama-rocm-7.2.4-rocmfpx:latest \
#     llama-server --help | grep -i spec-type
# If absent, drop the two --spec-* args.
# f16 KV required for ROCmFP4 — see chat unit for rationale.
Exec=llama-server \
      --alias code \
      -m /models/Qwopus3.6-27B-Coder-MTP-ROCmFP4-STRIX-embF16-headQ6.gguf \
      --host 0.0.0.0 --port 8082 \
      -c 131072 -np 1 \
      --no-context-shift \
      -ngl 99 -fa on \
      -dev Vulkan0 \
      -ctk f16 -ctv f16 \
      -b 2048 -ub 2048 \
      --spec-type draft-mtp --spec-draft-n-max 5 \
      --jinja \
      --chat-template-file /templates/qwen-froggeric-v21.jinja \
      --chat-template-kwargs '{"enable_thinking":false}' \
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0

[Service]
Restart=on-failure
RestartSec=20
TimeoutStartSec=1200
TimeoutStopSec=90

[Install]
WantedBy=default.target
